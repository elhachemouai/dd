<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pool Tracker Pro v4"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="• اكتشاف تلقائي 100% لحدود الطاولة على أي هاتف
• محاكاة متسلسلة لكل التصادمات والارتدادات
• مراعاة كاملة للدوران (Top / Back / Side Spin)
• تلوين كل مسار بلون الكرة الحقيقي"
        android:textAlignment="center"
        android:lineSpacingExtra="6dp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تشغيل الأداة (Start)"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إيقاف الأداة (Stop)" />

</LinearLayout>
